
{
  "cli_default_open_behavior": "existing_window",
  "disable_ai": true,
  "icon_theme": "Zed (Default)",
  "ui_font_size": 14,
  "buffer_font_size": 15,
  "theme": "Rosé Pine Moon",
  "theme_overrides": {
    "Rosé Pine Moon": {
      "border.variant": "#232136",
      "border": "#232136",
      "background": "#232136",
      "title_bar.background": "#c7c2ec",
      "panel.background": "#22212c",
      "panel.focused_border": "#eab8d3",
      "players": [
        {
          "cursor": "#e996c3"
        }
      ],
      "syntax": {
        "comment": {
          "font_style": "italic"
        },
        "comment.doc": {
          "font_style": "italic"
        },
        "keyword": {
          "color": "#a096e9"
        },
        "string": {
          "color":  "#c9c5ce"
        },
        "function": {
          "color": "#ffb4ab"
        },
        "operator": {
          "color": "#4a484f"
        },
        "number": {
          "color": "#928f98"
        },
        "boolean": {
          "color": "#c4bef4"
        },
        "variable": {
          "color": "#f4bedb"
        },
        "function.method": {
          "color": "#ffb4ab"
        },
        "function.special": {
          "color": "#ffb4ab"
        },
        "type": {
          "color": "#eab8d3"
        },
        "type.builtin": {
          "color": "#eab8d3"
        },
        "constructor": {
          "color": "#e996c3"
        },
        "attribute": {
          "color": "#e996c3"
        },
        "tag": {
          "color": "#a096e9"
        },
        "constant": {
          "color": "#3f3399"
        },
        "constant.builtin": {
          "color": "#c7c2ec"
        }
      },
    },
  },
  "title_bar": {
    "show_user_menu": false
  },
  "toolbar": {
    "quick_actions": false
  },
  "project_panel": {
    "auto_fold_dirs": false
  },
  "gutter": {
    "min_line_number_digits": 0,
  },
  "ui_font_family": "MesloLGL Nerd Font",
  "buffer_font_family": "MesloLGL Nerd Font",
  "cursor_shape": "block"
}
